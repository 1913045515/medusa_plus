STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2
# Internal URL the Medusa backend uses to notify the storefront to revalidate its
# Next.js menu cache after any menu change (server-to-server, no CORS issues).
# Docker: http://storefront:8000  |  Local dev: http://localhost:8000 (default)
STOREFRONT_INTERNAL_URL=http://localhost:8000

# Public-facing storefront URL used in order confirmation and registration emails.
# Example: https://www.mystore.com
STORE_FRONTEND_URL=http://localhost:8000

# PayPal payment configuration encryption key (32-byte base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYPAL_CONFIG_ENCRYPTION_KEY=

# 微信支付 APIv3（上面三项都填才会启用，本地可不填）
WECHATPAY_APP_ID=
WECHATPAY_MCH_ID=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=
WECHATPAY_MERCHANT_CERT_SERIAL_NO=
WECHATPAY_MERCHANT_PRIVATE_KEY_PATH=
WECHATPAY_PUBLIC_KEY_ID=
WECHATPAY_PUBLIC_KEY_PATH=
WECHATPAY_PAY_TYPE=native
WECHATPAY_CURRENCY=CNY
# 可选：如果要强制关闭微信支付（即使 env 已填）设 true
WECHATPAY_DISABLED=
